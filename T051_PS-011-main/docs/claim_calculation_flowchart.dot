digraph ClaimFlow {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.38", fontname="DejaVu Sans", label="PS-011 Claim Settlement Workflow", labelloc=t, fontsize=20];
  node [shape=box, style="rounded,filled", fillcolor="#F4F7FB", color="#344054", fontname="DejaVu Sans", fontsize=10, margin="0.16,0.10"];
  edge [color="#475467", fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];
  start [shape=oval, label="Start / claim command", fillcolor="#E8F1FF"];
  exists [label="Find claim and linked policy"];
  theft [shape=diamond, label="THEFT claim?", fillcolor="#FFF4D6"];
  fir [shape=diamond, label="FIR within 24 hours?", fillcolor="#FFF4D6"];
  wait [shape=diamond, label="90-day wait completed?", fillcolor="#FFF4D6"];
  recovery [shape=diamond, label="Recovered before day 90?", fillcolor="#FFF4D6"];
  theftsettle [label="Use IDV or eligible RTI invoice\nSubtract excess; apply delay deduction\nand learner cap if applicable"];
  pending [label="Keep theft settlement pending"];
  repair [label="Convert to repair assessment"];
  age [label="Calculate vehicle age and intimation delay"];
  late [shape=diamond, label="Intimation > 7 days?", fillcolor="#FFF4D6"];
  licence [shape=diamond, label="Licence valid?", fillcolor="#FFF4D6"];
  zero [label="Check ZERO_DEP eligibility"];
  total [label="Sum surveyed parts + labour\nbefore depreciation"];
  threshold [shape=diamond, label="Assessed cost ≥ 75% IDV?", fillcolor="#FFF4D6"];
  totalcalc [label="Total-loss: IDV / eligible RTI\nminus excess and retained salvage"];
  linecalc [label="Repair: check line coverage; apply\ndepreciation; pay covered labour"];
  gst [label="Add 18% GST for individual holder only"];
  excess [label="Subtract compulsory + voluntary excess"];
  delay [label="Apply 10% deduction if intimation > 48h"];
  learner [label="Apply 50% cap for learner licence"];
  min [shape=diamond, label="Payable < ₹500?", fillcolor="#FFF4D6"];
  below [label="Mark BELOW_THRESHOLD\n(no payment; still counts for NCB)", fillcolor="#FDECEC"];
  approve [label="Record approved settlement", fillcolor="#E8F7EE"];
  reject [label="Reject claim / record validation error", fillcolor="#FDECEC"];
  report [label="Store result and rule IDs; generate CSV reports"];
  end [shape=oval, label="End", fillcolor="#E8F1FF"];

  start -> exists -> theft;
  theft -> fir [label="Yes"];
  fir -> reject [label="No"];
  fir -> recovery [label="Yes"];
  recovery -> repair [label="Yes"];
  recovery -> wait [label="No"];
  wait -> pending [label="No"];
  wait -> theftsettle [label="Yes"];
  theftsettle -> report;
  pending -> report;
  theft -> age [label="No"];
  repair -> age;
  age -> late;
  late -> reject [label="Yes"];
  late -> licence [label="No"];
  licence -> reject [label="No"];
  licence -> zero [label="Yes"];
  zero -> total -> threshold;
  threshold -> totalcalc [label="Yes"];
  threshold -> linecalc [label="No"];
  totalcalc -> excess;
  linecalc -> gst -> excess;
  excess -> delay -> learner -> min;
  min -> below [label="Yes"];
  min -> approve [label="No"];
  below -> report;
  approve -> report;
  reject -> report;
  report -> end;
}
